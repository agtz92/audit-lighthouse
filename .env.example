# ─────────────────────────────────────────────────────────────────────────────
# site-monitor — copia este archivo a .env y ajusta lo que necesites.
# Todos los valores tienen un default razonable salvo POSTGRES_PASSWORD.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de datos ────────────────────────────────────────────────────────────
# Solo se usa dentro de la red de Compose; no se publica ningún puerto al host.
POSTGRES_USER=sitemon
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=sitemon

# Descomenta para poder conectarte con psql desde la Mac.
# El 5432 lo ocupa el Postgres nativo del host y el 5433 fantasy-hq, así que 5434.
# DB_PORT=5434

# ── Dashboard ────────────────────────────────────────────────────────────────
# Puerto publicado en la LAN: http://<ip-de-la-mac>:8480
# Evita 8096 (jellyfin) y 5173/6379/8000/5433 (fantasy-hq).
DASHBOARD_PORT=8480

# ── Programación ─────────────────────────────────────────────────────────────
# 06:00 en America/Mexico_City. El timezone lo aplica node-cron, así que sigue
# siendo 6am local pase lo que pase con el horario de verano.
TZ=America/Mexico_City
SCHEDULE_CRON=0 6 * * *

# Si el worker arranca y hoy ya pasaron las 6am sin una corrida exitosa,
# lanza una corrida de recuperación. Ponlo en false para desactivarlo.
RECOVERY_RUN_ON_BOOT=true

# ── Concurrencia y límites de tiempo ─────────────────────────────────────────
# Sitios auditados en paralelo. Con 3.8 GB en la VM de Docker, 2 es lo sano:
# cada sitio abre su propio Chromium. Súbelo solo si le das más RAM a Docker.
CONCURRENCY=2

# Páginas en paralelo dentro de un mismo sitio.
PAGE_CONCURRENCY=3

# Lighthouse en paralelo. Déjalo en 1: dos corridas simultáneas compiten por CPU
# y el score de performance varía entre días sin que el sitio haya cambiado.
LIGHTHOUSE_CONCURRENCY=1

# Presupuesto total de la corrida. Al agotarse ya no se empiezan sitios nuevos
# y la corrida queda marcada como 'partial' en la base de datos.
#
# 90 y no 45: Lighthouse corre de uno en uno y cuesta ~1.6 min por sitio, así
# que 20 sitios sanos son unos 39 minutos. Con 45 el margen era de 6 minutos y
# un solo sitio lento dejaba sitios sin auditar.
RUN_BUDGET_MINUTES=90

# Tope por sitio, además del global. Es el que impide que un solo sitio lento se
# lleve la corrida entera: el presupuesto global no puede cortar lo que ya está
# en vuelo, este sí. Medido aquí, un sitio con 21 páginas que se iban a timeout
# consumió 29 de los 45 minutos él solo.
SITE_BUDGET_MINUTES=8

# Timeouts por operación (ms).
NAV_TIMEOUT_MS=30000
LIGHTHOUSE_TIMEOUT_MS=120000

# ── Retención ────────────────────────────────────────────────────────────────
# Al final de cada corrida se purgan las corridas más viejas que esto.
RETENTION_DAYS=90

# ── Webhook (opcional) ───────────────────────────────────────────────────────
# Si está vacío no se manda nada. 3 intentos con backoff exponencial, timeout 10s.
# Una falla del webhook nunca marca la corrida como fallida.
WEBHOOK_URL=

# Umbrales de las banderas que van en el payload.
PERF_DROP_THRESHOLD=10
CERT_EXPIRY_WARN_DAYS=21

# ── PDFs ─────────────────────────────────────────────────────────────────────
# Compresión con Ghostscript de los dos archivos finales. El texto NUNCA se
# rasteriza (sigue siendo seleccionable); solo bajan de resolución las imágenes.
#   screen   imágenes a 72 dpi   - el más chico, se lee bien en pantalla
#   ebook    imágenes a 150 dpi  - equilibrio, el default
#   printer  imágenes a 300 dpi  - casi sin pérdida, reduce mucho menos
#   none     sin comprimir
PDF_QUALITY=ebook

# Base del tope de Ghostscript. El tope real crece con el tamaño del documento,
# porque comprimir es lineal en el tamaño y un número fijo deja sin comprimir
# justo a los archivos que más lo necesitan.
PDF_COMPRESS_TIMEOUT_MS=60000

# Tope para imprimir UNA página a PDF. page.pdf() de Playwright no trae timeout
# propio: una página con un canvas enorme lo deja colgado para siempre.
PDF_RENDER_TIMEOUT_MS=45000

# ── Marca del informe ────────────────────────────────────────────────────────
# Encabezan la portada y cada hoja de los PDFs.
REPORT_AUTHOR_NAME=José Alfredo Gutiérrez Guerra
REPORT_AUTHOR_ROLE=Consultor en soluciones de software e inteligencia artificial
REPORT_AUTHOR_CREDENTIALS=ITE 2016 · MNA 2027

# ── Rutas y varios ───────────────────────────────────────────────────────────
SITES_FILE=/app/sites.yaml
PDF_DIR=/data/pdfs
LOG_LEVEL=info
USER_AGENT=site-monitor/1.0 (+auditoria interna)
